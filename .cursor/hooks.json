{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/dc/serena-remind.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "\\boxlintrc\\b|\\boxfmtrc\\b|\\btsconfig\\b|\\beditorconfig\\b|\\bgitattributes\\b|\\bshellcheckrc\\b|\\bhooks\\.json\\b|\\bcursorignore\\b|\\bclaude/settings\\b|\\bclaude/hooks\\b|\\block-guardrails\\b|\\bunlock-guardrails\\b|\\bguardrail-manifest\\b",
        "command": ".cursor/hooks/dc/block-guardrail-files.sh"
      },
      {
        "matcher": "\\bgh\\s",
        "command": ".cursor/hooks/dc/block-gh-cli.sh"
      },
      {
        "matcher": "\\bgit\\s+(add|commit|push|reset|checkout|stash|branch\\s+-[dD]|rebase|merge|cherry-pick|revert|tag)\\b",
        "command": ".cursor/hooks/dc/block-git-write.sh"
      },
      {
        "matcher": "\\b(mongosh|mongo)\\b",
        "command": ".cursor/hooks/dc/block-mongo.sh"
      },
      {
        "matcher": "\\bsudo\\b",
        "command": ".cursor/hooks/dc/block-sudo.sh"
      },
      {
        "matcher": "\\b(kill|killall|pkill)\\b",
        "command": ".cursor/hooks/dc/block-kill.sh"
      },
      {
        "matcher": "\\b(npm|yarn|pnpm)\\s+publish\\b",
        "command": ".cursor/hooks/dc/block-publish.sh"
      },
      {
        "matcher": "\\b(dd|shutdown|reboot)\\b",
        "command": ".cursor/hooks/dc/block-dangerous.sh"
      },
      {
        "matcher": "\\.cursor/extensions/(local\\.dc|distro-ai\\.dc)",
        "command": ".cursor/hooks/dc/block-extension-overwrite.sh"
      },
      {
        "matcher": "\\brm\\s+.*-[a-zA-Z]*r[a-zA-Z]*\\b|\\brm\\s+-rf\\b",
        "command": ".cursor/hooks/dc/block-recursive-delete.sh"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/dc/block-guardrail-mcp.sh"
      }
    ]
  }
}
